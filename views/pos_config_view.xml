<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_session_details" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.session.details</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Session Details on Login" name="session_details_section">
                    <field name="enable_session_details"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
